.venv/
__pycache__/
*.pyc
# Large / reproducible data is ignored, but keep the small app lookup tables
# the running app needs. Note: comments must be on their own line — an inline
# comment becomes part of the pattern and silently breaks the ignore.
data/*
!data/attributes.csv
!data/common_names.csv
models/
reports/
runs/
*.pt
*.pth
.pytest_cache/
.DS_Store
.claude/current-goal.md
.claude/goal-iterations
.claude/goal-stalled.md
