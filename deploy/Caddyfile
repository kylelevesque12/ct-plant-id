# Caddy config — routes BOTH portfolio apps off one droplet and one domain.
# Install to /etc/caddy/Caddyfile, then: systemctl reload caddy
#
# Caddy obtains and renews Let's Encrypt certificates automatically for every
# hostname listed here. HTTPS is not optional for Fieldnote: the PWA's camera
# capture, service worker, and add-to-home-screen all require a secure context.

# ---------- Fieldnote: CT plant ID (FastAPI + PWA) ----------
fieldnote.kylelevesque.me {
    encode gzip

    # The app shell is served from disk with only ETag/Last-Modified and NO
    # Cache-Control, which makes browsers apply *heuristic* freshness — they can
    # serve a stale app.js for hours without ever asking the server. "no-cache"
    # means "you may store it, but always revalidate", so a deploy reaches
    # phones on the next load while unchanged files still cost only a 304.
    header /static/* Cache-Control "no-cache"
    header / Cache-Control "no-cache"

    # Phone photos are large; the API caps uploads itself but the proxy needs
    # room to pass them through.
    request_body {
        max_size 12MB
    }

    reverse_proxy 127.0.0.1:8700 {
        # Inference is ~0.1s, but be generous on a 1-vCPU box.
        transport http {
            response_header_timeout 60s
        }
    }

    # Logs go to journald (the package's systemd unit is hardened and cannot
    # write to /var/log/caddy). Read them with: journalctl -u caddy -f
}

# ---------- NFL player value analysis (Streamlit) — NOT YET DEPLOYED ----------
# Kept commented on purpose. Caddy tries to obtain a certificate for EVERY
# hostname in this file the moment it loads; if nfl.kylelevesque.me has no DNS record
# (or nothing is listening on :8501), that request fails and Caddy retries in a
# loop, spamming the log and rate-limiting you against Let's Encrypt.
#
# To add the NFL app later: create the DNS A record, start Streamlit on 8501
# (--server.headless true --server.address 127.0.0.1), uncomment this block,
# then `systemctl reload caddy`. Websocket upgrades are handled automatically.
#
# nfl.kylelevesque.me {
#     encode gzip
#
#     reverse_proxy 127.0.0.1:8501 {
#         transport http {
#             response_header_timeout 120s
#         }
#     }
# }
